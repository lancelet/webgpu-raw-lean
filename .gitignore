.direnv/
.lake/
# Downloaded by vendor/wgpu-native/fetch.sh
/vendor/wgpu-native/*/
# Downloaded by vendor/lean4/fetch.sh and vendor/libuv/fetch.sh
/vendor/lean4/*/
/vendor/libuv/*/
# Downloaded, or built, by vendor/sdl3/fetch.sh
/vendor/sdl3/*/
# CI only: the Emscripten SDK, cached by setup-emsdk
/emsdk-cache/

# Claude Code's local state, such as agents' worktrees
/.claude/

# Editor settings, kept per person
/.vscode/
